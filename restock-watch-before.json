const { chromium } = require('playwright');
const fs = require('fs');

const BASE_URL = process.env.MINA_URL;
const GITHUB_USERNAME = process.env.GITHUB_ACTOR;

/*
 * 今回監視する商品
 */
const PRODUCT_ID = 'FC0600YKPD';

const STATE_FILE = 'restock-watch-state.json';
const BEFORE_FILE = 'restock-watch-before.json';
const AFTER_FILE = 'restock-watch-after.json';
const DIFF_FILE = 'restock-watch-diff.json';

const PAGE_WAIT_MS = 12000;

if (!BASE_URL) {
  throw new Error(
    'MINA_URLが設定されていません。GitHub Actions Secretを確認してください。'
  );
}

/*
 * 日本時間を取得
 */
function getJapanTime() {
  return new Intl.DateTimeFormat('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23'
  }).format(new Date());
}

/*
 * 初期状態を作成
 */
function createInitialState() {
  return {
    productId: PRODUCT_ID,
    initialized: false,
    previousStatus: '',
    beforeSnapshotSaved: false,
    afterSnapshotSaved: false,
    firstCheckedAt: '',
    lastCheckedAt: '',
    restockedAt: ''
  };
}

/*
 * 古いスナップショットファイルを削除
 */
function removeOldSnapshotFiles() {
  const files = [
    BEFORE_FILE,
    AFTER_FILE,
    DIFF_FILE
  ];

  for (const file of files) {
    if (!fs.existsSync(file)) {
      continue;
    }

    try {
      fs.unlinkSync(file);

      console.log(
        `旧スナップショットを削除しました: ${file}`
      );
    } catch (error) {
      console.log(
        `${file}を削除できませんでした: ${error.message}`
      );
    }
  }
}

/*
 * 状態ファイルを読み込む
 */
function loadState() {
  if (!fs.existsSync(STATE_FILE)) {
    console.log(
      '状態ファイルがないため、新規監視として開始します'
    );

    return createInitialState();
  }

  try {
    const loaded = JSON.parse(
      fs.readFileSync(
        STATE_FILE,
        'utf8'
      )
    );

    /*
     * 状態ファイルに商品IDがない場合、
     * または別商品の商品IDが保存されている場合は、
     * 新商品の監視状態として初期化します。
     */
    if (
      !loaded.productId ||
      loaded.productId !== PRODUCT_ID
    ) {
      console.log(
        '監視商品が変更されたため、状態を初期化します'
      );

      console.log(
        `旧商品ID: ${loaded.productId || '未登録'}`
      );

      console.log(
        `新商品ID: ${PRODUCT_ID}`
      );

      removeOldSnapshotFiles();

      return createInitialState();
    }

    return {
      productId: PRODUCT_ID,

      initialized:
        Boolean(loaded.initialized),

      previousStatus:
        loaded.previousStatus || '',

      beforeSnapshotSaved:
        Boolean(
          loaded.beforeSnapshotSaved
        ),

      afterSnapshotSaved:
        Boolean(
          loaded.afterSnapshotSaved
        ),

      firstCheckedAt:
        loaded.firstCheckedAt || '',

      lastCheckedAt:
        loaded.lastCheckedAt || '',

      restockedAt:
        loaded.restockedAt || ''
    };
  } catch (error) {
    console.log(
      `状態ファイルを読み込めませんでした: ${error.message}`
    );

    console.log(
      '新規監視として状態を初期化します'
    );

    removeOldSnapshotFiles();

    return createInitialState();
  }
}

/*
 * 状態ファイルを保存
 */
function saveState(state) {
  fs.writeFileSync(
    STATE_FILE,
    JSON.stringify(
      state,
      null,
      2
    ),
    'utf8'
  );

  console.log(
    `${STATE_FILE}を保存しました`
  );
}

/*
 * 商品ページURLを作成
 *
 * MINA_URLはサイトのトップURLや
 * Fabric一覧URLのままで問題ありません。
 * 最終的な商品URLはPRODUCT_IDから作ります。
 */
function getProductUrl() {
  const baseUrl = new URL(BASE_URL);

  return new URL(
    `/online_store/${PRODUCT_ID}/`,
    baseUrl.origin
  ).href;
}

/*
 * URLからパスとクエリだけを取り出す
 */
function getSafePath(urlText) {
  try {
    const url = new URL(urlText);

    return (
      url.pathname +
      url.search
    );
  } catch {
    return urlText;
  }
}

/*
 * JSONとして解析できる場合だけ解析する
 */
function safeJsonParse(text) {
  try {
    return JSON.parse(text);
  } catch {
    return null;
  }
}

/*
 * 商品全体の状態を判定
 *
 * 1つでも購入可能なカラーがあればavailable
 * 全カラーがdisabledならsoldout
 * カラー情報を取れなければunknown
 */
function detectStatus(variants) {
  if (
    !Array.isArray(variants) ||
    variants.length === 0
  ) {
    return 'unknown';
  }

  const availableVariants =
    variants.filter(
      variant =>
        variant.disabled === false
    );

  if (availableVariants.length > 0) {
    return 'available';
  }

  return 'soldout';
}

/*
 * 比較の邪魔になる日時情報を除外
 */
function sanitizeForComparison(value) {
  if (value === null) {
    return null;
  }

  if (Array.isArray(value)) {
    return value.map(
      sanitizeForComparison
    );
  }

  if (typeof value === 'object') {
    const result = {};

    const ignoredKeys = new Set([
      'checkedAt',
      'createdAt',
      'updatedAt',
      'publishedAt',
      'lastCheckedAt'
    ]);

    for (
      const [key, child]
      of Object.entries(value)
    ) {
      if (ignoredKeys.has(key)) {
        continue;
      }

      result[key] =
        sanitizeForComparison(child);
    }

    return result;
  }

  return value;
}

/*
 * beforeとafterの全差分を作成
 */
function createDifferences(
  before,
  after,
  path = '',
  differences = []
) {
  /*
   * ファイルが巨大になりすぎないように
   * 最大5000件までに制限
   */
  if (differences.length >= 5000) {
    return differences;
  }

  if (before === after) {
    return differences;
  }

  const beforeIsObject =
    before !== null &&
    typeof before === 'object';

  const afterIsObject =
    after !== null &&
    typeof after === 'object';

  if (
    !beforeIsObject ||
    !afterIsObject
  ) {
    differences.push({
      path:
        path || '(root)',

      before:
        before === undefined
          ? '__MISSING__'
          : before,

      after:
        after === undefined
          ? '__MISSING__'
          : after
    });

    return differences;
  }

  if (
    Array.isArray(before) ||
    Array.isArray(after)
  ) {
    if (
      !Array.isArray(before) ||
      !Array.isArray(after)
    ) {
      differences.push({
        path:
          path || '(root)',
        before,
        after
      });

      return differences;
    }

    const maxLength =
      Math.max(
        before.length,
        after.length
      );

    for (
      let index = 0;
      index < maxLength;
      index++
    ) {
      createDifferences(
        before[index],
        after[index],
        `${path}[${index}]`,
        differences
      );

      if (differences.length >= 5000) {
        break;
      }
    }

    return differences;
  }

  const keys =
    new Set([
      ...Object.keys(before),
      ...Object.keys(after)
    ]);

  for (const key of keys) {
    const childPath =
      path
        ? `${path}.${key}`
        : key;

    createDifferences(
      before[key],
      after[key],
      childPath,
      differences
    );

    if (differences.length >= 5000) {
      break;
    }
  }

  return differences;
}

/*
 * 在庫に関係しそうな差分を抽出
 */
function findInterestingDifferences(
  differences
) {
  const pattern =
    /stock|inventory|quantity|available|availability|soldout|disabled|sku|variant|current|color|size|width/i;

  return differences.filter(
    difference =>
      pattern.test(
        difference.path
      )
  );
}

/*
 * 数値が変化した差分を抽出
 */
function findNumericDifferences(
  differences
) {
  return differences.filter(
    difference =>
      typeof difference.before ===
        'number' &&
      typeof difference.after ===
        'number' &&
      difference.before !==
        difference.after
  );
}

/*
 * GitHub Issueを作成
 */
async function createGitHubIssue(
  title,
  body
) {
  const token =
    process.env.GITHUB_TOKEN;

  const repository =
    process.env.GITHUB_REPOSITORY;

  if (!token || !repository) {
    console.log(
      'GitHub通知用の環境変数がありません'
    );

    return false;
  }

  const response = await fetch(
    `https://api.github.com/repos/${repository}/issues`,
    {
      method: 'POST',

      headers: {
        Accept:
          'application/vnd.github+json',

        Authorization:
          `Bearer ${token}`,

        'X-GitHub-Api-Version':
          '2022-11-28',

        'Content-Type':
          'application/json',

        'User-Agent':
          'restock-watch'
      },

      body: JSON.stringify({
        title,
        body
      })
    }
  );

  if (!response.ok) {
    console.log(
      `GitHub通知作成エラー: ` +
      `${response.status} ` +
      `${await response.text()}`
    );

    return false;
  }

  console.log(
    'GitHub通知を作成しました'
  );

  return true;
}

/*
 * 商品ページの完全スナップショットを取得
 */
async function captureSnapshot(browser) {
  const page =
    await browser.newPage({
      viewport: {
        width: 1440,
        height: 1200
      }
    });

  const networkTasks = [];

  /*
   * 商品ページを通常表示した際の
   * Fetch/XHRを記録します。
   *
   * かごへ入れる操作は行いません。
   * add.jsonも対象外です。
   */
  page.on(
    'response',
    response => {
      const task =
        (async () => {
          const request =
            response.request();

          const resourceType =
            request.resourceType();

          if (
            resourceType !== 'xhr' &&
            resourceType !== 'fetch'
          ) {
            return null;
          }

          const path =
            getSafePath(
              response.url()
            );

          if (path.includes('add.json')) {
            return null;
          }

          let bodyText = '';

          try {
            bodyText =
              await response.text();
          } catch (error) {
            return {
              resourceType,
              method:
                request.method(),
              path,
              status:
                response.status(),
              readError:
                error.message
            };
          }

          const parsedJson =
            safeJsonParse(bodyText);

          return {
            resourceType,

            method:
              request.method(),

            path,

            status:
              response.status(),

            contentType:
              response.headers()[
                'content-type'
              ] || '',

            requestPostData:
              request.postData() ||
              null,

            body:
              parsedJson !== null
                ? parsedJson
                : bodyText
          };
        })();

      networkTasks.push(task);
    }
  );

  try {
    const checkedAt =
      getJapanTime();

    const productUrl =
      getProductUrl();

    console.log(
      `商品ページを開きます: ${PRODUCT_ID}`
    );

    console.log(
      `商品URL: ${productUrl}`
    );

    await page.goto(
      productUrl,
      {
        waitUntil:
          'domcontentloaded',

        timeout:
          60000
      }
    );

    await page.waitForTimeout(
      PAGE_WAIT_MS
    );

    const pageData =
      await page.evaluate(
        productId => {
          const heading =
            document.querySelector('h1') ||
            document.querySelector('h2');

          const productName =
            heading
              ?.innerText
              ?.trim() ||
            document.title;

          const buttons =
            Array.from(
              document.querySelectorAll(
                'button.btn_line'
              )
            );

          const variants = [];

          for (const button of buttons) {
            const container =
              button.closest('li') ||
              button
                .parentElement
                ?.parentElement ||
              button.parentElement;

            if (!container) {
              continue;
            }

            const lines =
              container.innerText
                .split('\n')
                .map(
                  text =>
                    text.trim()
                )
                .filter(Boolean);

            const width =
              button.innerText
                .trim();

            const color =
              lines.find(
                text =>
                  text !== width &&
                  text !== 'カラー' &&
                  text !==
                    '生地巾(cm)' &&
                  text !==
                    'かごへ入れる' &&
                  !/^\d+(\.\d+)?$/i
                    .test(text) &&
                  !/^\d+(\.\d+)?CM$/i
                    .test(text)
              ) || '';

            variants.push({
              color,

              width,

              disabled:
                button.disabled,

              buttonText:
                button.innerText
                  .trim(),

              containerText:
                container.innerText
                  .replace(
                    /\s+/g,
                    ' '
                  )
                  .trim(),

              buttonAttributes:
                Object.fromEntries(
                  Array.from(
                    button.attributes
                  ).map(
                    attribute => [
                      attribute.name,
                      attribute.value
                    ]
                  )
                ),

              containerAttributes:
                Object.fromEntries(
                  Array.from(
                    container.attributes
                  ).map(
                    attribute => [
                      attribute.name,
                      attribute.value
                    ]
                  )
                )
            });
          }

          const scripts =
            Array.from(
              document.scripts
            ).map(
              (script, index) => ({
                index,

                src:
                  script.src || '',

                type:
                  script.type || '',

                text:
                  script.src
                    ? ''
                    : (
                        script.textContent ||
                        ''
                      )
              })
            );

          const localStorageData = {};

          for (
            let index = 0;
            index < localStorage.length;
            index++
          ) {
            const key =
              localStorage.key(index);

            localStorageData[key] =
              localStorage.getItem(key);
          }

          const sessionStorageData = {};

          for (
            let index = 0;
            index < sessionStorage.length;
            index++
          ) {
            const key =
              sessionStorage.key(index);

            sessionStorageData[key] =
              sessionStorage.getItem(key);
          }

          const dataAttributes = [];

          for (
            const element
            of Array.from(
              document.querySelectorAll('*')
            )
          ) {
            const attributes =
              Array.from(
                element.attributes || []
              );

            const dataValues =
              attributes.filter(
                attribute =>
                  attribute.name
                    .startsWith('data-')
              );

            if (dataValues.length === 0) {
              continue;
            }

            dataAttributes.push({
              tag:
                element.tagName,

              text:
                (
                  element.innerText ||
                  ''
                )
                  .replace(
                    /\s+/g,
                    ' '
                  )
                  .trim()
                  .slice(
                    0,
                    500
                  ),

              attributes:
                Object.fromEntries(
                  dataValues.map(
                    attribute => [
                      attribute.name,
                      attribute.value
                    ]
                  )
                )
            });
          }

          return {
            productId,

            productName,

            variants,

            scripts,

            productRelatedScripts:
              scripts.filter(
                script =>
                  script.text.includes(
                    productId
                  )
              ),

            localStorage:
              localStorageData,

            sessionStorage:
              sessionStorageData,

            dataAttributes,

            windowKeys:
              Object.keys(window)
                .sort()
          };
        },
        PRODUCT_ID
      );

    const html =
      await page.content();

    /*
     * ページ表示直後の通信が完了するのを
     * 少し待ってからまとめます。
     */
    await page.waitForTimeout(1000);

    const networkResponses =
      (
        await Promise.all(
          networkTasks
        )
      ).filter(Boolean);

    const status =
      detectStatus(
        pageData.variants
      );

    return {
      checkedAt,

      productId:
        PRODUCT_ID,

      productUrl,

      productName:
        pageData.productName,

      detectedStatus:
        status,

      cartActionPerformed:
        false,

      variants:
        pageData.variants,

      localStorage:
        pageData.localStorage,

      sessionStorage:
        pageData.sessionStorage,

      dataAttributes:
        pageData.dataAttributes,

      windowKeys:
        pageData.windowKeys,

      scripts:
        pageData.scripts,

      productRelatedScripts:
        pageData
          .productRelatedScripts,

      html,

      networkResponses
    };
  } finally {
    await page.close();
  }
}

/*
 * メイン処理
 */
(async () => {
  const state =
    loadState();

  const browser =
    await chromium.launch({
      headless: true
    });

  try {
    console.log(
      '=============================='
    );

    console.log(
      '再販自動観測'
    );

    console.log(
      `商品ID: ${PRODUCT_ID}`
    );

    console.log(
      `商品URL: ${getProductUrl()}`
    );

    console.log(
      'カート操作: なし'
    );

    console.log(
      '=============================='
    );

    const snapshot =
      await captureSnapshot(
        browser
      );

    const currentStatus =
      snapshot.detectedStatus;

    const previousStatus =
      state.previousStatus;

    console.log(
      `商品名: ${snapshot.productName}`
    );

    console.log(
      `前回状態: ${
        previousStatus ||
        '未登録'
      }`
    );

    console.log(
      `今回状態: ${currentStatus}`
    );

    console.log(
      `カラー数: ${
        snapshot.variants.length
      }`
    );

    console.log(
      `Fetch/XHR: ${
        snapshot
          .networkResponses
          .length
      }件`
    );

    /*
     * 商品情報を正常に取得できなかった場合は、
     * previousStatusを書き換えません。
     *
     * 一時的なページ取得失敗によって、
     * 誤った再販判定が起きるのを防ぎます。
     */
    if (currentStatus === 'unknown') {
      state.productId =
        PRODUCT_ID;

      state.lastCheckedAt =
        snapshot.checkedAt;

      saveState(state);

      throw new Error(
        '商品カラー情報を取得できなかったため、状態更新を中止しました'
      );
    }

    /*
     * 新商品の初回実行
     */
    if (!state.initialized) {
      state.productId =
        PRODUCT_ID;

      state.initialized =
        true;

      state.previousStatus =
        currentStatus;

      state.firstCheckedAt =
        snapshot.checkedAt;

      state.lastCheckedAt =
        snapshot.checkedAt;

      state.restockedAt = '';

      /*
       * 初回確認時点ですでにSOLD OUTなら、
       * その時点の完全データをbeforeとして保存
       */
      if (currentStatus === 'soldout') {
        fs.writeFileSync(
          BEFORE_FILE,
          JSON.stringify(
            snapshot,
            null,
            2
          ),
          'utf8'
        );

        state.beforeSnapshotSaved =
          true;

        console.log(
          'SOLD OUT時の完全スナップショットを保存しました'
        );
      } else {
        /*
         * 初回が販売中なら、
         * 旧beforeが残らないようにする
         */
        state.beforeSnapshotSaved =
          false;
      }

      state.afterSnapshotSaved =
        false;

      saveState(state);

      console.log(
        '新商品の初回基準値として保存しました'
      );

      console.log(
        '初回実行のため、再販通知は行いません'
      );

      return;
    }

    /*
     * beforeがまだない状態で
     * SOLD OUTを確認した場合
     */
    if (
      currentStatus === 'soldout' &&
      !state.beforeSnapshotSaved
    ) {
      fs.writeFileSync(
        BEFORE_FILE,
        JSON.stringify(
          snapshot,
          null,
          2
        ),
        'utf8'
      );

      state.beforeSnapshotSaved =
        true;

      /*
       * 新しいSOLD OUT期間に入ったため、
       * 前回のafter・diffが残っていれば削除
       */
      for (
        const file
        of [
          AFTER_FILE,
          DIFF_FILE
        ]
      ) {
        if (fs.existsSync(file)) {
          fs.unlinkSync(file);

          console.log(
            `前回の再販データを削除しました: ${file}`
          );
        }
      }

      state.afterSnapshotSaved =
        false;

      state.restockedAt = '';

      console.log(
        'SOLD OUT時の完全スナップショットを保存しました'
      );
    }

    /*
     * 前回SOLD OUT、今回購入可能なら再販
     */
    const restocked =
      previousStatus === 'soldout' &&
      currentStatus === 'available';

    if (restocked) {
      const restockedAt =
        snapshot.checkedAt;

      console.log(
        '★ 再販を検知しました'
      );

      /*
       * 再販後スナップショットを保存
       */
      fs.writeFileSync(
        AFTER_FILE,
        JSON.stringify(
          snapshot,
          null,
          2
        ),
        'utf8'
      );

      state.afterSnapshotSaved =
        true;

      state.restockedAt =
        restockedAt;

      /*
       * SOLD OUT時と再販後を比較
       */
      let beforeSnapshot = null;

      if (fs.existsSync(BEFORE_FILE)) {
        try {
          beforeSnapshot =
            JSON.parse(
              fs.readFileSync(
                BEFORE_FILE,
                'utf8'
              )
            );
        } catch (error) {
          console.log(
            `再販前データを読み込めませんでした: ${error.message}`
          );
        }
      }

      /*
       * 別商品のbeforeを間違って比較しない
       */
      if (
        beforeSnapshot &&
        beforeSnapshot.productId !==
          PRODUCT_ID
      ) {
        console.log(
          'beforeデータが別商品のため、差分比較を中止します'
        );

        console.log(
          `beforeの商品ID: ${
            beforeSnapshot.productId ||
            '未登録'
          }`
        );

        console.log(
          `現在の商品ID: ${PRODUCT_ID}`
        );

        beforeSnapshot = null;
      }

      if (beforeSnapshot) {
        const safeBefore =
          sanitizeForComparison(
            beforeSnapshot
          );

        const safeAfter =
          sanitizeForComparison(
            snapshot
          );

        const differences =
          createDifferences(
            safeBefore,
            safeAfter
          );

        const interestingDifferences =
          findInterestingDifferences(
            differences
          );

        const numericDifferences =
          findNumericDifferences(
            differences
          );

        const diffResult = {
          productId:
            PRODUCT_ID,

          productName:
            snapshot.productName,

          productUrl:
            snapshot.productUrl,

          beforeStatus:
            beforeSnapshot
              .detectedStatus,

          afterStatus:
            snapshot
              .detectedStatus,

          beforeCheckedAt:
            beforeSnapshot
              .checkedAt,

          afterCheckedAt:
            snapshot
              .checkedAt,

          totalDifferenceCount:
            differences.length,

          interestingDifferenceCount:
            interestingDifferences
              .length,

          numericDifferenceCount:
            numericDifferences.length,

          interestingDifferences,

          numericDifferences,

          allDifferences:
            differences
        };

        fs.writeFileSync(
          DIFF_FILE,
          JSON.stringify(
            diffResult,
            null,
            2
          ),
          'utf8'
        );

        console.log(
          `全差分: ${differences.length}件`
        );

        console.log(
          `在庫関連候補: ${interestingDifferences.length}件`
        );

        console.log(
          `数値変化: ${numericDifferences.length}件`
        );
      } else {
        console.log(
          '有効な再販前データがないため、差分ファイルは作成しません'
        );
      }

      const availableVariants =
        snapshot.variants.filter(
          variant =>
            variant.disabled === false
        );

      const variantText =
        availableVariants.length > 0
          ? availableVariants
              .map(
                variant =>
                  `- ${variant.color || 'カラー名不明'}` +
                  ` / 生地巾 ` +
                  `${variant.width || '不明'}cm`
              )
              .join('\n')
          : '- 取得できませんでした';

      const mention =
        GITHUB_USERNAME
          ? `@${GITHUB_USERNAME}`
          : '';

      const diffText =
        beforeSnapshot
          ? `- 全差分：${DIFF_FILE}`
          : '- 全差分：再販前データがないため未作成';

      await createGitHubIssue(
        `🧪 ${PRODUCT_ID} 再販検知・完全データ取得`,
`${mention}

## ${PRODUCT_ID}の再販を検知しました

### 商品名

${snapshot.productName}

### 商品URL

${snapshot.productUrl}

### 購入可能カラー

${variantText}

### 検知時刻

${restockedAt}（日本時間）

### 調査データ

- 再販前：${BEFORE_FILE}
- 再販後：${AFTER_FILE}
${diffText}
- カート操作：なし

SOLD OUTから購入可能への変化を検知しました。`
      );
    }

    state.productId =
      PRODUCT_ID;

    state.previousStatus =
      currentStatus;

    state.lastCheckedAt =
      snapshot.checkedAt;

    saveState(state);

    console.log(
      '=============================='
    );

    console.log(
      '今回の確認終了'
    );

    console.log(
      `現在状態: ${currentStatus}`
    );

    console.log(
      '=============================='
    );
  } catch (error) {
    console.error(
      `再販観測エラー: ${error.stack}`
    );

    process.exitCode = 1;
  } finally {
    await browser.close();
  }
})();
